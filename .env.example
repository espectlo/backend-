# Copiar a .env y reemplazar SECRET_KEY antes de producción.
SECRET_KEY=django-insecure-solo-desarrollo
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite local, no requiere credenciales.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# Para PostgreSQL, instalar psycopg y configurar estas variables:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=inventario
# DB_USER=usuario
# DB_PASSWORD=contraseña
# DB_HOST=localhost
# DB_PORT=5432
# CSRF_TRUSTED_ORIGINS=https://inventario.ejemplo.cl
